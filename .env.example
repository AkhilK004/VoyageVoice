# Groq API for Free LLM (Llama 3)
GROQ_API_KEY=your_groq_api_key_here

# Deepgram API for STT ($200 free credit)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq model (Llama 3 is extremely fast and free)
GROQ_MODEL=llama-3.1-8b-instant

# Edge TTS voice (Free Microsoft TTS)
# Good options: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
EDGE_TTS_VOICE=en-US-AriaNeural

# Server
HOST=0.0.0.0
PORT=8000
